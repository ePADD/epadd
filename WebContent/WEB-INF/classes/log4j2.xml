<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{dd MMM HH:mm:ss} %c{1} %-5p - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- used until Log4JUtils.initialize() sets up the log files; keep the levels in sync with it -->
        <Logger name="edu.stanford" level="ALL"/>
        <Logger name="net.sf.ehcache" level="OFF"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
